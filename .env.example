# Copy to .env.local for local development.
#
# Firebase web config — client-side values, safe to ship in the bundle.
# From Firebase console -> Project settings -> Your apps -> Web app.
# In production these come from apphosting.yaml (or App Hosting's injected
# FIREBASE_WEBAPP_CONFIG once the backend is linked to a Web App).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nail-salon-poc
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Point the browser SDK at the local emulator suite.
NEXT_PUBLIC_USE_EMULATORS=true

# --- Server-only (never prefixed NEXT_PUBLIC_) -------------------------------

# Read by lib/server/quick-book.ts. Get one from https://aistudio.google.com/apikey
# In production this is a Secret Manager secret referenced from apphosting.yaml —
# it must never reach the client.
GEMINI_API_KEY=

# Tells the Admin SDK to talk to the emulators instead of the real project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# For running Server Actions against a REAL project locally, drop the two
# EMULATOR_HOST lines above and point this at a service-account key instead:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
